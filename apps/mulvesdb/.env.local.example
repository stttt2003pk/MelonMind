# 本地Milvus测试环境配置
# 复制此文件为 .env.local 并根据实际情况修改

# Milvus数据库配置
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_DATABASE=default
MILVUS_USERNAME=
MILVUS_PASSWORD=
MILVUS_SSL_ENABLED=false
MILVUS_TIMEOUT=30
MILVUS_CONNECTION_NAME=Local Milvus Test

# Docker Compose相关
DOCKER_VOLUME_DIRECTORY=./volumes

# 测试配置
TEST_COLLECTION_NAME=test_vectors
TEST_VECTOR_DIMENSION=128
TEST_VECTOR_COUNT=1000