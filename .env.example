# Security
SECRET_KEY=your-secret-key-here

# Debug Settings
DEBUG=true

# Database Settings (PostgreSQL as default, set USE_SQLITE=true for SQLite)
USE_SQLITE=false
DB_ENGINE=django.db.backends.postgresql
DB_NAME=melonmind
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432

# Redis Settings (for Celery)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Qwen API Settings
QWEN_API_KEY=your-qwen-api-key-here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
USE_MOCK_EMBEDDING=true

# CORS Settings (Production)
# Comma-separated list of allowed origins
# Example: https://yourdomain.com,https://subdomain.yourdomain.com
CORS_ALLOWED_ORIGINS=

# For allowing all origins in development only (NOT recommended for production)
# Set to 'true' to enable CORS_ALLOW_ALL_ORIGINS
CORS_ALLOW_ALL_ORIGINS=false